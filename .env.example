# See src/env.mjs for the schema that validates these at startup.

# Auth.js. Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3025"

# Spotify developer app
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# LLM engines
OPENAI_ORGANIZATION_ID=""
OPENAI_KEY=""
GEMINI_API_KEY=""
# Optional: Last.fm top tags as evidence; without it that source reports off.
LASTFM_API_KEY=""
# Evidence lookups: per-source deadline and MusicBrainz pacing.
EVIDENCE_DEADLINE_MS="2500"
MUSICBRAINZ_INTERVAL_MS="1000"

# Turso (bun run dev starts a local instance at this URL)
TURSO_DATABASE_URL="http://127.0.0.1:8080"
TURSO_AUTH_TOKEN=""
