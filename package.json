{
	"name": "music-gippity",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.0",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"ci": "biome ci .",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"eval": "LIVE_EVAL=1 bun --env-file=.env.development test ./evals/harness.eval.ts",
		"eval:recording-evidence": "LIVE_EVAL=1 bun --env-file=.env.development test ./evals/recording-evidence.eval.ts",
		"eval:compare-vocals": "LIVE_EVAL=1 bun --env-file=.env.development test ./evals/compare-vocal-repairs.eval.ts",
		"eval:snapshot-listener": "bun --env-file=.env.production evals/snapshot-listener.ts",
		"next:dev": "next dev -p 3025 --turbo #--experimental-https",
		"dev": "concurrently --kill-others -n \"db,app\" -c \"bgBlue.bold,bgMagenta.bold\" \"bun run db:dev\" \"bun run next:dev\"",
		"db:generate": "dotenv -e .env.production drizzle-kit generate",
		"db:push": "dotenv -e .env.production -- drizzle-kit push",
		"db:migrate": "dotenv -e .env.production -- drizzle-kit migrate",
		"db:studio": "dotenv -e .env.production -- drizzle-kit studio",
		"db:dev": "turso dev --db-file ./db.sqlite",
		"build": "next build",
		"start": "next start -p 3025",
		"prepare": "husky"
	},
	"dependencies": {
		"@auth/drizzle-adapter": "^1.11.3",
		"@hookform/resolvers": "^5",
		"@libsql/client": "^0.18.0",
		"@next/bundle-analyzer": "^16.3.5",
		"@paralleldrive/cuid2": "^3.3.0",
		"@radix-ui/react-accordion": "^1.2.20",
		"@radix-ui/react-alert-dialog": "^1.1.23",
		"@radix-ui/react-checkbox": "^1.3.11",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-popover": "^1.1.23",
		"@radix-ui/react-radio-group": "^1.4.7",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-tooltip": "^1.2.16",
		"@t3-oss/env-nextjs": "^0.13.11",
		"@tanstack/react-query": "^5.102.8",
		"@trpc/client": "^11.18.0",
		"@trpc/next": "^11.18.0",
		"@trpc/react-query": "^11.18.0",
		"@trpc/server": "^11.18.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"drizzle-orm": "^0.45.2",
		"embla-carousel-react": "^8.6.0",
		"lucide-react": "^1.45.0",
		"motion": "^13.2.0",
		"next": "^16.3.5",
		"next-auth": "^5.0.0-beta.32",
		"next-themes": "^0.4.6",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-hook-form": "^7.88.0",
		"server-only": "^0.0.1",
		"superjson": "^2.2.6",
		"uuid": "^14.0.2",
		"workflow": "^4.8.9",
		"zod": "^4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/bun": "^1.4.2",
		"@types/node": "^24",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"concurrently": "^10.0.5",
		"dotenv-cli": "^11.0.0",
		"drizzle-kit": "^0.31.10",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "6.0.3"
	},
	"ct3aMetadata": {
		"initVersion": "7.13.1"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,css,md,json}": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
